{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://fantasy-asturfutbol.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw.js|workbox-(.*).js|index.html|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
